\#include "Java_${className}.h"
\#include "FkJniDefinition.h"
\#include "FkJavaRuntime.h"

namespace Java_${className} {
#ifdef __cplusplus
    extern "C" {
#endif

    /**
     * +--------------------------------------------+
     * |  START of internal interface. DO NOT EDIT  |
     * +--------------------------------------------+
     */
#foreach($method in ${classMethods})
    ${method.returnType} _${method.name}(JNIEnv *env, jclass cls, ${method.args}) {
#if (${method.hasReturn})
        return ${method.returnCastPrefix}${method.name}(env, cls, ${method.argsCOnlyName})${method.returnCastSuffix};
#else
        ${method.name}(env, cls, ${method.argsCOnlyName});
#end
    }

#end
    /**
     * +------------------------------------------+
     * |  END of internal interface. DO NOT EDIT  |
     * +------------------------------------------+
     */

    bool reg(JNIEnv *env) {
        return FkJavaRuntime::jniRegister(env, CLASS_NAME, METHODS, METHODS_NUM);
    }

    const char *CLASS_NAME = "${classCanonicalName}";

    const int METHODS_NUM = ${classMethodCnt};

    const JNINativeMethod METHODS[] = {
#foreach($method in ${classMethods})
            {"${method.name}", "(${method.argsSig})${method.returnSig}", (void *) _${method.name}},
#end
    };

#ifdef __cplusplus
    }
#endif
};